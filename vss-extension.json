{
  "manifestVersion": 1,
  "id": "iis-deploy-extension",
  "publisher": "SojkaLabs",
  "version": "1.0.0",
  "name": "IIS Deploy Extension",
  "friendlyName": "IIS Deploy Extension",
  "description": "Extension that deploys artifacts to IIS and manages app pools.",
  "categories": ["Azure Pipelines"],
  "targets": [
    { "id": "Microsoft.VisualStudio.Services" }
  ],
  "contributions": [
    {
      "id": "IISDeployTask",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "IISDeployTask"
      }
    }
  ],
  "files": [
    { "path": "IISDeployTask" }
  ]
}